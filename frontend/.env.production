# ─────────────────────────────────────────────────────────────────────────────
# Production environment — used by Vite during `npm run build`.
#
# When deploying via Vercel Services (vercel.json at repo root):
#   VITE_API_URL is injected automatically by the frontend→backend binding.
#   Do NOT set it manually in the Vercel dashboard — the binding owns it.
#
# VITE_WS_URL is left empty intentionally. Vercel does not proxy WebSocket
# upgrades, so the WS connection will fail silently and the app falls back
# to REST polling (every 8 seconds) which keeps all data live.
#
# For local dev, copy this file to .env and set:
#   VITE_API_URL=http://localhost:8000
#   VITE_WS_URL=ws://localhost:8000/ws/digital-twin
# ─────────────────────────────────────────────────────────────────────────────

# Injected by Vercel at build time via the services binding — do not set here
# VITE_API_URL=

# WebSocket not supported through Vercel rewrites — left empty (REST fallback)
VITE_WS_URL=
