# ─────────────────────────────────────────────────────────────────────────────
# Production environment — used by Vite during `npm run build`.
#
# IMPORTANT: Replace the placeholder URLs below with your deployed backend
# address BEFORE pushing to Vercel, OR set them as Vercel Environment
# Variables in the Vercel dashboard (Project → Settings → Environment
# Variables). Vercel dashboard values override this file.
#
# If you are running the backend locally during the demo and want Vercel to
# reach it, you can use ngrok:
#   ngrok http 8000
# and paste the resulting https:// and wss:// URLs here.
# ─────────────────────────────────────────────────────────────────────────────

# Replace with your actual deployed backend URL
# Examples:
#   Render :  https://baghewala-api.onrender.com
#   Railway:  https://baghewala-api.up.railway.app
#   ngrok  :  https://xxxx-xx-xx-xx-xx.ngrok-free.app
VITE_API_URL=https://your-backend-url.onrender.com

# Replace with the WebSocket URL of your deployed backend (wss:// not ws://)
VITE_WS_URL=wss://your-backend-url.onrender.com/ws/digital-twin
